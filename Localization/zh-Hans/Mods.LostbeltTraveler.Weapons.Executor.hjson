GhostKnife: {
	DisplayName: 幽灵短匕
	Tooltip: 直线投掷一把穿透多名敌人，命中后额外追击的匕首
	ExecutionStrike:
		'''
		生成一个存在60秒的幽灵标记，强化代行者的所有攻击
		幽灵标记存在期间，代行者的暴击概率提升10%
		并且在攻击过程中发射幽灵短匕，命中时不会追击匕首
		'''
}

DesertKnife: {
	DisplayName: 沙丘短刀
	Tooltip: 可穿透3名敌人
	ExecutionStrike:
		'''
		生成一个存在120秒的沙漠标记，强化代行者的所有攻击
		沙漠标记存在期间，代行者大部分武器的穿透次数+2
		不穿透的武器不生效
		'''
}

DungeonKnife: {
	DisplayName: 钢制匕首
	Tooltip: 撞击墙体时朝距离最近的敌人弹射
	ExecutionStrike:
		'''
		生成一个存在30秒的地牢标记，强化代行者的所有攻击
		地牢标记存在期间，代行者的防御力提升8点
		并且地牢敌人对你的造成的伤害减少85%
		'''
}

FishronKnife: {
	DisplayName: 公爵长牙
	Tooltip: 命中时追加追踪敌人的泡泡
	ExecutionStrike:
		'''
		生成一个存在60秒的公爵标记，强化代行者的所有攻击
		公爵标记存在期间，代行者的伤害提升20%
		并且使你在水中自由游泳
		'''
}

GrassKnife: {
	DisplayName: 草刀
	Tooltip:
		'''
		命中时对敌人造成特殊的丛林剧毒
		丛林剧毒会对敌人造成25/50/100点减益伤害
		减益伤害随流程强化
		'''
	ExecutionStrike:
		'''
		生成一个存在60秒的丛林标记，强化代行者的所有攻击
		丛林标记存在期间，代行者附加可堆叠10层的丛林剧毒
		草刀直接命中时，若目标丛林剧毒超过3层，则立刻结算该次伤害
		'''
}

MoltenKnife: {
	DisplayName: 狱火投刀
	Tooltip: 命中时造成爆炸
	ExecutionStrike:
		'''
		生成一个存在60秒的狱火标记，强化代行者的所有攻击
		狱火标记存在期间，代行者附加狱火爆炸
		狱火爆炸频率固定，取造成伤害的2.75x，不可暴击
		'''
}

TheSevenStar: {
	DisplayName: 七星
	Tooltip:
		'''
		向光标位置发射一颗星星
		在身后点亮北斗七星
		'''
	ExecutionStrike:
		'''
		七颗亮星向光标位置发射一道光束
		光束会穿透多名敌人
		'''
}

StormSaber: {
	DisplayName: 风暴战戟
	Tooltip:
		'''
		摧毁敌人
		以残断剑身与残余风暴之力粗暴重组的异构产物
		虽非正统，仍可对巨人发挥些旧日之力
		'''
	ExecutionStrike: 增强武器挥舞速度
}

TheGreatDipper: {
	DisplayName: 极星
	Tooltip:
		'''
		向光标位置发射两枚追踪亮星
		在身后点亮北斗七星
		该模式下处决手动执行
		'''
	ExecutionStrike:
		'''
		每次挥舞发射7枚追踪亮星，并逐步点亮背后的北斗七星
		北斗七星在完全点亮后自动释放处决攻击
		释放后切换回初始模式，同时在光标位置展开银河
		'''
	Special: ""
}

BambooBow: {
	DisplayName: 敏捷竹弓
	Tooltip: ""
	ExecutionStrike:
		'''
		强化接下来的12次攻击
		提高攻击速度，箭矢飞行的速度
		箭矢将穿透一名敌人
		'''
}

BambooSword: {
	DisplayName: 习武竹刀
	Tooltip: 强制击飞敌人
	ExecutionStrike:
		'''
		将竹刀直接掷出
		竹刀会不断旋转并打击靠近的敌人
		打击时总会制停对方
		'''
}

ClimaticHawstring: {
	DisplayName: 气候钓弦
	Tooltip:
		'''
		手持时小飞棍从天而降，协助攻击敌人
		“以天竿为弓，以气候为弦”
		'''
	ExecutionStrike:
		'''
		使[i:LostbeltTraveler/ClimaticHawstring][c/EAEA00:气候钓弦]在接下来
		5秒内连续发射热能激光
		'''
}

WeHaveBookshelf: {
	DisplayName: 力拔书架气盖世
	Tooltip:
		'''
		震撼敌人
		“我们有大书架！”
		'''
	ExecutionStrike:
		'''
		强化[i:LostbeltTraveler/WeHaveBookshelf]力拔书架气盖世的攻击
		接下来的15次挥舞将释放更多书本
		'''
}

Stella: {
	DisplayName: 流星一条
	Tooltip: 发射着魔的火焰箭矢
	ExecutionStrike:
		'''
		在处决过程中免疫伤害
		蓄力一定时间后，自动向光标位置发射一枚威力极大的流星箭矢
		流星箭矢将会造成10000%伤害，无视防御力，必定暴击，且拥有极广的伤害范围
		处决执行完毕后处死你自己
		'''
}

Headsplosion: {
	DisplayName: 爆头
	Tooltip:
		'''
		你的攻击必定暴击，射出的子弹总会造成爆炸
		爆炸总会弹射出多个可造成二次爆炸的小型跳弹
		小型爆炸跳弹会造成[ScarletDebuff/Terraria/Ichor]
		'''
	ExecutionStrike:
		'''
		追加更多的小型跳弹
		小型跳弹爆炸会追加两枚分裂跳弹
		'''
	FlavorTooltip: 这样的事天天都有。
}

Moonfire: {
	DisplayName: 月火
	Tooltip:
		'''
		精度极高的左轮手枪
		可随时按下<SCARLETMOD:MODKEY>进行处决
		'''
	ExecutionStrike:
		'''
		发射一枚强化子弹，在多个敌人间跃迁
		其跃迁的次数与消耗的处决次数成正比
		'''
	FlavorTooltip: 接受命运的安排……
}

Reflux: {
	DisplayName: 逆流
	Tooltip: 发射多枚子弹，施加[ScarletDebuff/Terraria/CursedInferno]
	ExecutionStrike:
		'''
		发射穿透次数更多的子弹
		子弹首次命中时生成腐蚀链，连锁附近的两名目标
		一个目标最多可以被五条腐蚀链连锁
		'''
	FlavorTooltip: 烧起来吧。
}

TheGarcia: {
	DisplayName: 加西亚家族
	Tooltip: 射速较快的霰弹枪
	ExecutionStrike: 发射更多的子弹，散射更小
	FlavorTooltip: 木仓，木仓。
}

CrescentRose: {
	DisplayName: 新月玫瑰
	Tooltip:
		'''
		手持时[ScarletBuff/LostbeltTraveler/AntiKnockbackBuff]
		每次挥舞或命中时将向前方发射大口径狙击弹
		按下右键时将镰刀置于身后开火迫使你向前推进
		推进时无敌，且沿途斩切命中时治疗你自己
		'''
	ExecutionStrike:
		'''
		新月玫瑰将转为狙击步枪模式
		该模式下攻击总会发射大口径狙击弹
		按下右键时将提供极大的后坐力使你向后方退开
		退开过程中无敌，并释放延迟追踪敌人的玫瑰
		该模式下大口径狙击弹必定造成暴击
		'''
	FlavorTooltips: 艳若玫瑰填我梦，带我入尔安息所
}

CobaltYoyo: {
	DisplayName: 钴蓝悠悠球
	Tooltip:
		'''
		命中时造成钴蓝爆炸
		不可被[i:YoyoBag][i:YoYoGlove]增强
		'''
	ExecutionStrike:
		'''
		强化[i:LostbeltTraveler/CobaltYoyo]钴蓝悠悠球的攻击10秒
		每次命中都会造成钴蓝爆炸
		具备高额护甲穿透
		'''
}

TitaniumBattleShovel: {
	DisplayName: 钛金工兵铲
	Tooltip: 命中时击晕敌人一定时间
	ExecutionStrike:
		'''
		强化接下来10秒内的攻击
		提升攻击范围与判定次数
		'''
}

MythrilStaff: {
