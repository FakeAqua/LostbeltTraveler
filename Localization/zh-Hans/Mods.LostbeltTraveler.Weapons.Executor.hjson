Exsanguination: {
	DisplayName: 放血疗法
	Tooltip:
		'''
		以超高的频率发射超高速的子弹流
		射出的所有子弹都会造成真实伤害
		'''
	ExecutionStrike:
		'''
		粉碎敌人的护盾
		独立强化武器1.12x伤害
		'''
}

MantleLayer: {
	DisplayName: 地幔
	Tooltip: 命中时将对敌人进行重击
	ExecutionStrike:
		'''
		掷出的{0}会尝试挂载距离其最近的敌人
		造成总共12次伤害后，再进行两次力度的更大重击
		'''
}

DungeonBreaker: {
	DisplayName: 地牢破坏者
	Tooltip:
		'''
		命中时，造成一次范围伤害的冲击
		会直接破坏地牢内的危险类物块
		进入困难模式时，可以直接破坏地牢方块
		'''
	ExecutionStrike:
		'''
		高速掷出且允许无限穿透
		砸入墙体后将持续释放遇墙反弹的水箭
		'''
}

FleshGrinder: {
	DisplayName: 碾肉机
	Tooltip: 命中将碾压敌人的血肉使其爆开
	ExecutionStrike:
		'''
		追踪多名敌人，分别造成6次伤害
		最多可追踪4名敌人
		'''
}

JungleMadness: {
	DisplayName: 丛林狂怒
	Tooltip: 命中释放短暂的穿墙树叶
	ExecutionStrike:
		'''
		返程后回击，并挂载在敌人上造成12次伤害
		每次造成伤害时都会追加穿墙的旋转树叶
		'''
}

DreamlessNight: {
	DisplayName: 无梦之夜
	Tooltip:
		'''
		命中时，释放梦境之花
		大部分攻击施加[ScarletDebuff/LostbeltTraveler/ForeverNightBuff]
		'''
	ExecutionStrike:
		'''
		召唤一把模拟玩家行动的仆从锤
		在场时，强化无梦之夜的普通攻击
		只有攻击时才会消耗仆从锤的在场时间
		在场时间殆尽时将朝玩家光标方向冲刺
		仆从锤在场时不会增加处决叠层次数
		'''
	FlavorTooltips: 我于那漫漫长夜中，思念着梦的存在
}

TheDefiler: {
	DisplayName: 玷污者
	Tooltip: 命中将感染敌人的血肉使其糜烂
	ExecutionStrike:
		'''
		追踪多名敌人，分别造成4次伤害
		最多可追踪7名敌人
		'''
}

AetherfireSmasher: {
	DisplayName: 天炎破
	Tooltip:
		'''
		掷出后飞越至附近可用的敌人
		成功命中时追加追踪火球
		'''
	ExecutionStrike:
		'''
		掷出的[i:LostbeltTraveler/AetherfireSmasher]天炎破将挂载在目标上
		持续造成伤害，并释放火柱与追踪火球
		'''
}

BinaryStars: {
	DisplayName: 双子星
	Tooltip: 命中时，追击迅捷的星云之矢
	ExecutionStrike:
		'''
		同时掷出强大双子锤
		双子锤将持续重创你的敌人
		'''
}

CrimsonScythe: {
	DisplayName: 猩红重镰
	Tooltip:
		'''
		手持时提供[ScarletBuff/LostbeltTraveler/AntiKnockbackBuff]
		持续劈砍下，第四轮劈砍提升攻击范围
		命中时放血，释放灵魂石，并施加[ScarletDebuff/ContinentOfJourney/DivineFireBuff]，
		你可以通过劈砍的方式，将灵魂石中的灵魂打回原主
		也可以通过按下右键以收割灵魂石，恢复你的生命
		'''
	ExecutionStrike:
		'''
		接下来的20次劈砍中每次命中时，都会为你增加2点防御力
		劈砍过程中自动将场上的灵魂石进行回收
		吸收一份灵魂的同时将另一份灵魂打回原主
		'''
	FlavorTooltips: 红月之下，无人能逃过她的收割
	ExtraMechanic:
		'''
		[i:LostbeltTraveler/ReaperHead]与[c/E50015:前台死神套装]一同组合时，获得如下效果
		[i:LostbeltTraveler/ReaperBody]增加15%代行者伤害、暴击概率与暴击伤害和30点防御力
		[i:LostbeltTraveler/ReaperLegs]允许无限飞行时间，获得冲刺能力
		'''
	ConditionMechanic:
		'''
		黑色的第一太阳封存了这件物品的力量
		或许应该去尝试超越太阳之神了
		'''

	KillerType: {
		OnlyCoins:
			'''
			对该物品按下右键以切换城镇NPC击杀选项：
			当前允许击杀NPC，仅掉落钱币
			'''
		AllStuff:
			'''
			对该物品按下右键以切换城镇NPC击杀选项：
			当前允许击杀城镇NPC，掉落钱币和特殊物品
			'''
		NoKilling:
			'''
			对该物品按下右键以切换城镇NPC击杀选项：
			当前击杀城镇NPC功能已关闭
			'''
	}
}

DeathTolls: {
	DisplayName: 死亡丧钟
	Tooltip: 命中时，引梦魇之箭从天而降
	ExecutionStrike:
		'''
		召唤一把模拟玩家行动的仆从锤
		在场时，强化死亡丧钟的普通攻击
		同时，处决攻击将延迟挂载，释放暗影魔能与梦魇之箭
		只有攻击时才会消耗仆从锤的在场时间
		在场时间殆尽时将朝玩家光标方向冲刺
		仆从锤在场时不会增加处决叠层次数
		'''
	FlavorTooltips: 于丧钟中冥思，召陨星归位，释梦魇噬敌
}

TheJudgement: {
	DisplayName: 圣神断罪
	Tooltip: 命中时，迸发断罪之星
	ExecutionStrike:
		'''
		召唤一把挂载锤，锁定附近的敌人
		挂载时释放裁决新星，在消失后释放神圣射线
		挂载锤只有在攻击敌人时才会消耗在场时间
		挂载锤在场时不会增加处决叠层次数
		最多只存在一把挂载锤
		'''
}

DreamingLight: {
	DisplayName: 铸梦之光
	Tooltip:
		'''
		命中时，召唤梦境之锤
		大部分攻击施加[ScarletDebuff/LostbeltTraveler/ForeverNightBuff]
		'''
	ExecutionStrike:
		'''
		召唤一把模拟玩家行动的仆从锤
		在场时，强化铸梦之光的普通攻击
		只有攻击时才会消耗仆从锤的在场时间
		在场时间殆尽时将朝玩家光标方向冲刺
		仆从锤在场时不会增加处决叠层次数
		'''
	FlavorTooltips: 我于那长眠之夜中，铸就了梦的归来
}

ThePunishment: {
	DisplayName: 神明裁决
	Tooltip: 命中时，追击裁决新星
	ExecutionStrike:
		'''
		召唤一把挂载锤，锁定附近的敌人
		挂载时释放裁决新星
		挂载锤只有在攻击敌人时才会消耗在场时间
		挂载锤在场时不会增加处决叠层次数
		最多只存在一把挂载锤
		'''
}

SimpleHandAxe: {
	DisplayName: 简易双刃斧
	Tooltip:
		'''
		可穿透一名敌人
