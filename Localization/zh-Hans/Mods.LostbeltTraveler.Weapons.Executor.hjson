TheCompanion: {
	DisplayName: 同伴
	Tooltip:
		'''
		不暴击时施加[ScarletDebuff/Terraria/Oiled]
		暴击时施加[ScarletDebuff/Terraria/OnFire3]
		'''
	ExecutionStrike:
		'''
		发射一枚必定暴击的子弹
		在命中时对大范围的敌人施加狱火
		无数量上限
		'''
	FlavorTooltip: 你无法夺走我的天空。
}

LunarHammer: {
	DisplayName: 夜明陨星
	Tooltip:
		'''
		沿途倾泻月耀能量
		“旧物重生，再一次”
		'''
	ExecutionStrike:
		'''
		返程时回击，发射夜明轨迹
		而后延迟挂载，倾泻月耀能量
		'''
}

CaptainDeadBeard: {
	DisplayName: 死须船长
	Tooltip:
		'''
		拥有霰弹模式与狙击模式，右键切换
		霰弹模式下，背包内拥有两枚金币时，额外发射卑鄙霰弹
		狙击模式下，不攻击时增加攻击伤害
		“这位船长在2016年的冬季，带着鹦鹉伙伴加入了这片草坪。”
		'''
	ExecutionStrike: 抛射骑乘大炮，同时呼叫炮兵支援
}

DragonBallSword: {
	DisplayName: 勇者之剑
	DisplayNameAlt: 界王神剑
	Tooltip: 发射剑气摧毁敌人
	TooltipAlt:
		'''
		不会发射剑气
		命中时以“气”的力量切割敌人
		'''
	FlavorTooltip: 从某个已经被破坏的时空捡到的，不用客气。
	FlavorTooltipAlt: 哦，这个只是用卡奇卡钦钢做的仿制品罢了。
	ExecutionStrike:
		'''
		切换为界王神剑，挥舞出强力斩击
		此后以界王神剑为默认形态
		'''
	ExecutionStrikeAlt:
		'''
		掷出界王神剑同时切换为勇者之剑
		此后以勇者之剑为默认形态
		界王神剑会在空中旋转一定时间
		你可以再次按下<SCARLETMOD:MODKEY>，传送到界王神剑的位置进行斩切
		'''
}

