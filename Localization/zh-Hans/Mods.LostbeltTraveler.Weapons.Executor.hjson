Sundowner: {
	DisplayName: 焚风
	Tooltip:
		'''
		同时发射直线飞行的炮弹与追踪敌人的流火
		"不，你用这个不会变得无敌"
		'''
	ExecutionStrike:
		'''
		投掷一个信号枪以呼叫空袭
		你可以按住右键使空袭集中目标
		'''
}

FrostoftheStorm: {
	DisplayName: 寒霜风暴
	Tooltip:
		'''
		挥砍时释放无限穿透的寒风
		所有的攻击都会施加[ScarletDebuff/LostbeltTraveler/AbsoluteZeroBuff]
		'''
	ExecutionStrike:
		'''
		以快慢的节奏进行连续挥砍
		大幅度提升挥砍与寒风体积
		'''
}

FrostHammer: {
	DisplayName: 冰砾
	Tooltip: 沿途滞留下坠的冰锥
	ExecutionStrike:
		'''
		掷出一个雪花，追杀你的敌人
		接下来释放的冰锥都会集中攻击雪花追杀的目标
		对光标附近的敌人右键，会使雪花重新锁定这名目标
		'''
}

DualWraithStaff: {
	DisplayName: 双魂魔杖
	Tooltip:
		'''
		发射追踪幽魂
		“幽魂之咒，一杖双形”
		'''
	ExecutionStrike:
		'''
		魔杖将会展开刀刃，切换为投矛形态
		投矛形态下允许穿越墙体，穿透3名敌人
		只有首次命中时才会生成追踪的幽魂射弹
		再次执行处决攻击时将切换回第一形态
		'''
}

PrunusMume: {
	DisplayName: 红梅
	Tooltip: 沿途滞留一定时间后四散开来的红梅花
	ExecutionStrike:
		'''
		抛掷一朵红梅花仆从，
		靠近敌人并发射红梅花瓣
		可以同时存在3个红梅花仆从
		'''
}

StaffofFrostbite: {
	// DisplayName: Staffof Frostbite
	// Tooltip: ""
}

GaiaStriker: {
	DisplayName: 盖亚重锤
	Tooltip: 掷出一定时间后，爆裂血腥飞弹
	ExecutionStrike:
		'''
		盖亚重锤爆开后转变为仆从锤
		按下<SCARLETMOD:MODKEY>在射线模式与自动模式之间切换
		自动模式自动攻击附近敌人
		射线模式释放猩红射线，手持时占用普攻增强射线
		射线模式下每次攻击回复少量存续时间
		存续耗尽时爆裂并治疗你
		长按右键可提前爆裂，获得更多治疗并返还处决叠层
		'''
	FlavorTooltips: 大地之母最为残暴的一面

	Conditions: {
		FirstTime: 首次合成前且不在多人游戏内
		SecondTime: 首次使用盖亚宝箱后或正处于多人游戏内
	}
}

Frostlight: {
	DisplayName: 寒霜火炬
	Tooltip:
		'''
		快速发射迅捷追随鼠标位置的寒霜流火
		所有的攻击都会施加[ScarletDebuff/LostbeltTraveler/AbsoluteZeroBuff]
		'''
	ExecutionStrike:
		'''
		旋转火炬指向前方，以喷火器的形式倾泻寒霜之火
		再次执行处决攻击时将切换回第一形态
		'''
}

PureYinyo: {
	DisplayName: 至纯阴阳
	Tooltip:
		'''
		交替投掷阴阳双锤
		太阴之锤命中时同时造成[ScarletDebuff/Terraria/CursedInferno]与[ScarletDebuff/Terraria/Ichor]，并迸发黑暗碎块
		太阳之锤沿途生成轨迹飘忽不定的光明碎块
		'''
	ExecutionStrike:
		'''
		至纯阴阳掷出后持续攻击附近的敌人
		在攻击结束时，将迸发大量的碎块
		'''
}

LavaFlow: {
	DisplayName: 熔岩流
	Tooltip:
		'''
		命中时爆炸
		“旧物重生”
		'''
	ExecutionStrike:
		'''
		命中时刺入敌人
		[i:LostbeltTraveler/LavaFlow][c/EF9A05:熔岩流]后续追击该名
		敌人时都会向上迸发火球
		'''
}

StarofHope: {
	DisplayName: 希望之星
	Tooltip:
		'''
		一枚闪耀之星朝向光标坠落
		执行处决时，给予支援增益60秒
		“爱与希望的故事”
		'''
	ExecutionStrike:
		'''
		所有代行者攻击都会天降闪耀之星
		该闪耀之星在命中敌人时将叠加玩家手持武器的处决进程
		'''
}

BoneSlap: {
	DisplayName: 骨掌
	Tooltip:
		'''
		无视首次命中的敌人的防御力
		拍中敌人时抛射大量细碎的小骨头
		执行处决时，给予支援增益60秒
		“啪！”
		'''
	ExecutionStrike:
		'''
		代行者的支援鞭子都将无视防御力
		同时，大幅度提升支援鞭子的攻击速度
		'''
}

StreamingProtocol: {
	DisplayName: 推流协议
	Tooltip:
		'''
		命中时生成一封骚扰邮件
		执行处决时，给予支援增益60秒
		”基于HTTPS”
		'''
	ExecutionStrike:
		'''
		令非支援道具类代行者武器在命中时，
		叠加支援道具类代行者武器的处决进程
		'''
}

AngryBomb: {
	DisplayName: 愤怒炸弹
	Tooltip:
		'''
		掷出后追踪附近的敌人
		飞行过程中有概率自爆
		'''
	ExecutionStrike:
		'''
		这枚炸弹将更加愤怒
		飞行时不再自爆，追踪范围也更广
		'''
}

TearEye: {
	DisplayName: 克苏鲁的眼泪
	Tooltip:
		'''
		伤害衰减力度非常低
		执行处决时，给予支援增益60秒
		'''
	ExecutionStrike:
		'''
		代行者攻击增加伤害减免
		同时，使代行者获得潮湿减益
		'''
}

ContainedBlast: {
	DisplayName: 遏制爆炸
	Tooltip:
		'''
		先后快速发射冲击弹与粘弹
		冲击弹会穿透多个敌人，粘弹会粘附在敌人上
		每个敌人最多粘附一枚粘弹
		'''
	ExecutionStrike:
		'''
		引爆场上所有粘弹，根据造成的伤害次数提供效果：
		为遏制爆炸提供独立增伤，最大35%
		增强遏制爆炸的攻击频率，并使遏制爆炸的攻击必定暴击
		'''
	FlavorTooltip: 盖上盖子。
}

EndlessWar: {
	DisplayName: 无尽战争
	Tooltip: 命中时，追及惩戒闪电
	ExecutionStrike:
		'''
		无尽战争将在命中后变化为特殊性质仆从锤
		悬挂的仆从锤将自动攻击附近的敌人，同时会以其为中心在周围降下多道闪电
		仆从锤在场期间再次按下<SCARLETMOD:MODKEY>，或即将消失时，将朝向你攻击的方向进行三次大范围的重击
		重击无视防御力，挥击过程中也会持续释放闪电，且每次命中时都会震慑敌人
		'''
	FlavorTooltips: ""
}

SplendidofTerra: {
	DisplayName: 璀璨大地
	Tooltip: 掷出一定时间后，释放生命飞弹
	ExecutionStrike:
		'''
		璀璨大地将在命中后变化为特殊性质仆从锤
		仆从锤在场时，可通过按下<SCARLETMOD:MODKEY>以在射线模式与自动模式切换
		自动模式下仆从锤会自动攻击附近的敌人
		射线模式下将会释放生命光线，手持璀璨大地时占用其普通攻击以增强射线功能
		射线模式下，手持璀璨大地每次进行攻击时，会为仆从锤回复少量存续时间
		存续时间殆尽时，璀璨大地将会消散，为你提供治疗
		你也可以通过长按鼠标右键一定时刻后，提前使仆从锤消散，获得更多的治疗，返还处决叠层
		'''
	FlavorTooltips: 「-本属于泛人类史的存在-」
}

ASMD: {
	DisplayName: A.S.M.D
	Tooltip:
		'''
		发射电磁霜炎炮弹
		命中时造成爆炸，并施加[ScarletDebuff/Terraria/Frostburn2]
